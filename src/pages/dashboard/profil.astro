---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { createAvatarSignedUrl, getAvatarStoragePath } from '../../lib/avatar';

const user = Astro.locals.user!;
const profile = Astro.locals.profile;
const nimValue = profile?.nim || user.user_metadata?.nim || '';
const nim = typeof nimValue === 'string' ? nimValue.trim() : '';
const displayName = profile?.nama_lengkap || user.user_metadata?.nama_lengkap || profile?.nim || user.user_metadata?.nim || 'Member';
const hasNim = Boolean(nim && (/^\d+$/.test(nim) || nim !== displayName));
const avatarPath = getAvatarStoragePath(profile?.avatar_url);
const avatarUrl = await createAvatarSignedUrl(Astro.locals.supabase, avatarPath);
---

<DashboardLayout
  title="Profil Mahasiswa | siDeutsch"
  description="Kelola informasi profil mahasiswa siDeutsch."
  active="profile"
  user={user}
  profile={profile}
>
  <section class="profile-content">
      <div id="password-alert" class="password-alert" role="alert" aria-live="assertive" hidden></div>
      <header class="page-heading">
        <p class="eyebrow">Akun Mahasiswa</p>
        <h1>Profil</h1>
        <p>Perbarui nama dan foto profilmu.</p>
      </header>

      <form
        id="profile-form"
        class="profile-form"
        data-avatar-path={avatarPath ?? ''}
      >
        <div class="avatar-editor">
          <div class="avatar-frame">
            <div class="avatar-preview-wrap">
              <img id="avatar-preview" class="avatar-preview" src={avatarUrl ?? ''} alt="Foto profil" hidden={!avatarUrl} />
              <span id="avatar-preview-fallback" class="avatar-fallback" aria-hidden="true" hidden={!!avatarUrl}>
                {(displayName || nim || 'M').slice(0, 1).toUpperCase()}
              </span>
            </div>
            <input id="file-upload" class="avatar-file-input" name="avatar" type="file" accept="image/png,image/jpeg,image/webp" />
            <label class="avatar-camera" for="file-upload" title="Ganti foto profil">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5H8L6.5 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2.5L16 5h-2Z" />
                <circle cx="12" cy="13" r="3.5" />
              </svg>
              <span class="visually-hidden">Pilih foto profil</span>
            </label>
          </div>
          <div class="avatar-upload">
            <span class="avatar-upload-title">Foto Profil</span>
            <small>PNG, JPG, atau WebP. Maksimal 5 MB.</small>
          </div>
        </div>

        <label for="nama-lengkap">Nama Lengkap</label>
        <input
          id="nama-lengkap"
          name="nama_lengkap"
          type="text"
          value={displayName}
          autocomplete="name"
          placeholder="Masukkan nama lengkap"
          required
        />

        <label for="nim">{hasNim ? 'NIM' : 'Status Akun'}</label>
        <input id="nim" name="nim" type="text" value={hasNim ? nim : 'Umum'} readonly />

        <button id="profile-submit" type="submit">Simpan Perubahan</button>
        <p id="profile-message" class="profile-message" role="status" aria-live="polite"></p>
      </form>

      <section class="password-section" aria-labelledby="password-title">
        <header class="password-heading">
          <p class="eyebrow">Keamanan Akun</p>
          <h2 id="password-title">Ganti Password</h2>
          <p>Gunakan kata sandi baru yang mudah kamu ingat dan sulit ditebak.</p>
        </header>
        <form id="password-form" class="password-form" novalidate>
          <label for="new-password">Password Baru</label>
          <div class="password-input-wrap">
            <input
              id="new-password"
              name="new-password"
              type="password"
              autocomplete="new-password"
              placeholder="Masukkan password baru"
              required
              minlength="6"
            />
            <button type="button" class="password-toggle" data-password-toggle="new-password" aria-label="Tampilkan password" aria-pressed="false">
              <svg class="eye-open" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.7" />
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6.1 0 9.5 6 9.5 6a16 16 0 0 1-3.1 3.7M6.2 6.3C3.8 7.8 2.5 12 2.5 12s3.4 6 9.5 6c.8 0 1.5-.1 2.2-.3" />
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
              </svg>
            </button>
          </div>

          <label for="confirm-password">Konfirmasi Password Baru</label>
          <div class="password-input-wrap">
            <input
              id="confirm-password"
              name="confirm-password"
              type="password"
              autocomplete="new-password"
              placeholder="Ulangi password baru"
              required
              minlength="6"
            />
            <button type="button" class="password-toggle" data-password-toggle="confirm-password" aria-label="Tampilkan password" aria-pressed="false">
              <svg class="eye-open" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.7" />
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6.1 0 9.5 6 9.5 6a16 16 0 0 1-3.1 3.7M6.2 6.3C3.8 7.8 2.5 12 2.5 12s3.4 6 9.5 6c.8 0 1.5-.1 2.2-.3" />
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
              </svg>
            </button>
          </div>

          <button id="password-submit" type="submit">Simpan Password Baru</button>
        </form>
      </section>
  </section>
</DashboardLayout>

<script>
  import { createBrowserClient } from '@supabase/ssr';

  document.addEventListener('astro:page-load', () => {
  const form = document.querySelector<HTMLFormElement>('#profile-form');
  const fileInput = document.querySelector<HTMLInputElement>('#file-upload');
  const avatarPreview = document.querySelector<HTMLImageElement>('#avatar-preview');
  const avatarFallback = document.querySelector<HTMLElement>('#avatar-preview-fallback');
  const submitButton = document.querySelector<HTMLButtonElement>('#profile-submit');
  const message = document.querySelector<HTMLElement>('#profile-message');
  const passwordForm = document.querySelector<HTMLFormElement>('#password-form');
  const passwordSubmit = document.querySelector<HTMLButtonElement>('#password-submit');
  const passwordAlert = document.querySelector<HTMLElement>('#password-alert');
  let passwordAlertTimer: number | undefined;
  let selectedAvatar: File | null = null;

  const showPasswordAlert = (text: string, state: 'success' | 'error') => {
    if (!passwordAlert) return;
    window.clearTimeout(passwordAlertTimer);
    passwordAlert.textContent = text;
    passwordAlert.dataset.state = state;
    passwordAlert.hidden = false;
    passwordAlertTimer = window.setTimeout(() => {
      passwordAlert.hidden = true;
    }, 4000);
  };

  avatarPreview?.addEventListener('error', () => {
    avatarPreview.hidden = true;
    if (avatarFallback) avatarFallback.hidden = false;
  });
  if (avatarPreview?.complete && avatarPreview.naturalWidth === 0 && avatarPreview.src) {
    avatarPreview.hidden = true;
    if (avatarFallback) avatarFallback.hidden = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const target = document.getElementById(toggle.dataset.passwordToggle ?? '');
      if (!(target instanceof HTMLInputElement)) return;
      const isVisible = target.type === 'text';
      target.type = isVisible ? 'password' : 'text';
      toggle.setAttribute('aria-pressed', String(!isVisible));
      toggle.setAttribute('aria-label', isVisible ? 'Tampilkan password' : 'Sembunyikan password');
    });
  });

  passwordForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const newPassword = passwordForm.querySelector<HTMLInputElement>('#new-password')?.value ?? '';
    const confirmPassword = passwordForm.querySelector<HTMLInputElement>('#confirm-password')?.value ?? '';

    if (newPassword.length < 6) {
      showPasswordAlert('Password baru minimal 6 karakter.', 'error');
      return;
    }

    if (newPassword !== confirmPassword) {
      showPasswordAlert('Konfirmasi password tidak sama.', 'error');
      return;
    }

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!supabaseUrl || !supabaseAnonKey) {
      showPasswordAlert('Konfigurasi Supabase belum tersedia.', 'error');
      return;
    }

    if (!passwordSubmit) return;
    passwordSubmit.disabled = true;

    try {
      const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);
      const { error } = await supabase.auth.updateUser({ password: newPassword });
      if (error) throw error;

      passwordForm.reset();
      passwordForm.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-pressed', 'false');
        toggle.setAttribute('aria-label', 'Tampilkan password');
      });
      showPasswordAlert('Password berhasil diubah!', 'success');
      window.setTimeout(() => {
        window.location.href = '/dashboard';
      }, 2000);
    } catch (error) {
      showPasswordAlert(
        error instanceof Error ? `Password gagal diubah: ${error.message}` : 'Password gagal diubah. Coba lagi.',
        'error'
      );
    } finally {
      passwordSubmit.disabled = false;
    }
  });

  fileInput?.addEventListener('change', () => {
    selectedAvatar = fileInput.files?.[0] ?? null;
    if (!selectedAvatar || !avatarPreview || !message) return;

    if (!['image/png', 'image/jpeg', 'image/webp'].includes(selectedAvatar.type) || selectedAvatar.size > 5 * 1024 * 1024) {
      selectedAvatar = null;
      fileInput.value = '';
      message.textContent = 'File harus berupa PNG, JPG, atau WebP dengan ukuran maksimal 5 MB.';
      message.dataset.state = 'error';
      return;
    }

    if (avatarPreview.src.startsWith('blob:')) URL.revokeObjectURL(avatarPreview.src);
    avatarPreview.src = URL.createObjectURL(selectedAvatar);
    avatarPreview.hidden = false;
    if (avatarFallback) avatarFallback.hidden = true;
    message.textContent = '';
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitButton || !message) return;

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    if (!supabaseUrl || !supabaseAnonKey) {
      message.textContent = 'Konfigurasi Supabase belum tersedia.';
      message.dataset.state = 'error';
      return;
    }

    const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);
    const { data: { user }, error: authError } = await supabase.auth.getUser();
    if (authError || !user) {
      message.textContent = 'Sesi login berakhir. Silakan login kembali.';
      message.dataset.state = 'error';
      return;
    }

    const formData = new FormData(form);
    const namaLengkap = String(formData.get('nama_lengkap') ?? '').trim();
    let nextAvatarPath = form.dataset.avatarPath || null;
    let nextAvatarSignedUrl: string | null = null;
    let avatarSignedUrlError: string | null = null;

    submitButton.disabled = true;
    message.textContent = 'Menyimpan profil...';
    message.dataset.state = 'loading';

    try {
      if (selectedAvatar) {
        const extensionByType: Record<string, string> = {
          'image/png': 'png',
          'image/jpeg': 'jpg',
          'image/webp': 'webp',
        };
        const extension = extensionByType[selectedAvatar.type];
        const storagePath = `${user.id}/avatar.${extension}`;
        const { error: uploadError } = await supabase.storage
          .from('avatars')
          .upload(storagePath, selectedAvatar, {
            cacheControl: '0',
            contentType: selectedAvatar.type,
            upsert: true,
          });

        if (uploadError) throw uploadError;

        nextAvatarPath = storagePath;
        const { data: signedUrlData, error: signedUrlError } = await supabase.storage
          .from('avatars')
          .createSignedUrl(storagePath, 60 * 60);
        if (signedUrlError) {
          console.error('Failed to create avatar signed URL:', signedUrlError.message);
          avatarSignedUrlError = signedUrlError.message;
        } else {
          nextAvatarSignedUrl = signedUrlData.signedUrl;
        }
      }

      const { data: savedProfile, error: saveError } = await supabase
        .from('profiles')
        .update({ nama_lengkap: namaLengkap, avatar_url: nextAvatarPath })
        .eq('id', user.id)
        .select('id')
        .maybeSingle();

      if (saveError) throw saveError;
      if (!savedProfile) throw new Error('Profil tidak ditemukan.');

      form.dataset.avatarPath = nextAvatarPath ?? '';
      if (avatarPreview && avatarFallback) {
        if (selectedAvatar && nextAvatarSignedUrl) {
          avatarPreview.src = nextAvatarSignedUrl;
          avatarPreview.hidden = false;
          avatarFallback.hidden = true;
        } else if (selectedAvatar) {
          avatarPreview.removeAttribute('src');
          avatarPreview.hidden = true;
          avatarFallback.hidden = false;
        }
      }
      selectedAvatar = null;
      if (fileInput) fileInput.value = '';
      message.textContent = avatarSignedUrlError
        ? `Profil berhasil disimpan, tetapi foto belum dapat ditampilkan: ${avatarSignedUrlError}`
        : 'Profil berhasil disimpan.';
      message.dataset.state = 'success';
    } catch (error) {
      message.textContent = error instanceof Error
        ? `Profil gagal disimpan: ${error.message}`
        : 'Profil gagal disimpan. Coba lagi.';
      message.dataset.state = 'error';
    } finally {
      submitButton.disabled = false;
    }
  });
  });
</script>

<style>
  .profile-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 2rem;
    min-height: 640px;
  }

  .profile-sidebar {
    display: flex;
    flex-direction: column;
    min-height: 640px;
    padding: 1.25rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
  }

  .sidebar-brand {
    padding: 0.3rem 0.5rem 1.3rem;
    color: var(--text-main);
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sidebar-brand span {
    color: var(--accent-gold);
  }

  .sidebar-nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .sidebar-nav a,
  .logout-form button {
    display: flex;
    min-height: 42px;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #475569;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .sidebar-nav a span,
  .logout-form button span {
    width: 1.2rem;
    color: #64748b;
    font-size: 1.05rem;
    text-align: center;
  }

  .sidebar-nav a.active {
    background: #F7E5C2;
    color: var(--text-main);
  }

  .sidebar-nav a:hover,
  .logout-form button:hover {
    background: #F7E5C2;
    color: var(--text-main);
  }

  .logout-form {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .logout-form button {
    width: 100%;
  }

  .profile-content {
    position: relative;
    max-width: 760px;
    padding: 0.5rem 0;
  }

  .password-alert {
    position: fixed;
    z-index: 1000;
    top: 1.25rem;
    left: 50%;
    width: min(560px, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    transform: translateX(-50%);
    border: 1px solid #86efac;
    border-radius: 12px;
    background: #f0fdf4;
    color: #166534;
    box-shadow: 0 12px 32px rgba(22, 101, 52, 0.16);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .password-alert[data-state='error'] {
    border-color: #fecaca;
    background: #fef2f2;
    color: #b91c1c;
    box-shadow: 0 12px 32px rgba(185, 28, 28, 0.14);
  }

  .page-heading {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--text-main);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text-main);
    font-size: 2.2rem;
  }

  .page-heading > p:last-child {
    margin: 0.6rem 0 0;
    color: #64748b;
  }

  .profile-form {
    display: grid;
    gap: 0.65rem;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
  }

  .profile-form > label,
  .avatar-upload label {
    margin-top: 0.35rem;
    color: #334155;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .profile-form > input {
    width: 100%;
    min-height: 46px;
    padding: 0.7rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: var(--text-main);
    font: inherit;
  }

  .profile-form > input:focus-visible,
  .avatar-upload input:focus-visible {
    outline: 3px solid rgba(229, 169, 59, 0.22);
    border-color: var(--accent-gold);
  }

  .profile-form > input[readonly] {
    background: #f1f5f9;
    color: #64748b;
  }

  .avatar-editor {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .avatar-frame {
    position: relative;
    width: 88px;
    height: 88px;
    flex: 0 0 auto;
  }

  .avatar-preview-wrap {
    width: 88px;
    height: 88px;
    overflow: hidden;
    border: 3px solid var(--accent-gold);
    border-radius: 50%;
    background: #F7E5C2;
    box-shadow: 0 4px 12px rgba(26, 26, 30, 0.1);
  }

  .avatar-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-preview[hidden] {
    display: none;
  }

  .avatar-fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--text-main);
    font-size: 1.8rem;
    font-weight: 800;
  }

  .avatar-upload {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .avatar-file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .avatar-camera {
    position: absolute;
    right: -3px;
    bottom: -3px;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--accent-gold);
    color: var(--bg-dark);
    box-shadow: 0 3px 9px rgba(26, 26, 30, 0.2);
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .avatar-camera:hover {
    transform: scale(1.08);
    background: #F0B84F;
  }

  .avatar-camera svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avatar-file-input:focus-visible + .avatar-camera {
    outline: 3px solid rgba(229, 169, 59, 0.38);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .avatar-upload-title {
    color: #334155;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .avatar-upload small {
    color: #64748b;
    font-size: 0.74rem;
  }

  .profile-form > button {
    min-height: 48px;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 8px;
    background: var(--accent-gold);
    color: var(--text-main);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .profile-form > button:hover:not(:disabled) {
    background: #F0B84F;
  }

  .profile-form > button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .profile-message {
    min-height: 1.2rem;
    margin: 0;
    color: #15803d;
    font-size: 0.82rem;
  }

  .profile-message[data-state='error'] {
    color: var(--accent-red);
  }

  .password-section {
    display: grid;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .password-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-size: 1.35rem;
  }

  .password-heading > p:last-child {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .password-form {
    display: grid;
    gap: 0.65rem;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
  }

  .password-form > label {
    margin-top: 0.35rem;
    color: #334155;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .password-input-wrap {
    position: relative;
  }

  .password-input-wrap input {
    width: 100%;
    min-height: 46px;
    padding: 0.7rem 3rem 0.7rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: var(--text-main);
    font: inherit;
  }

  .password-input-wrap input:focus-visible {
    outline: 3px solid rgba(229, 169, 59, 0.22);
    border-color: var(--accent-gold);
  }

  .password-toggle {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    transform: translateY(-50%);
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .password-toggle:hover {
    background: #f1f5f9;
    color: var(--text-main);
  }

  .password-toggle:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 1px;
  }

  .password-toggle svg {
    width: 20px;
    height: 20px;

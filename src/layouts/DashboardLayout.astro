---
import { createAvatarSignedUrl } from '../lib/avatar';

const {
  title = 'Dashboard | siDeutsch',
  description = 'Portal mahasiswa siDeutsch.',
  variant = 'student',
  active = '',
  user = null,
  profile = null,
} = Astro.props;
import { ClientRouter } from 'astro:transitions';

const isAdmin = variant === 'admin';
const displayName = profile?.nama_lengkap || user?.user_metadata?.nama_lengkap || profile?.nim || user?.user_metadata?.nim || 'Member';
const nimValue = profile?.nim || user?.user_metadata?.nim || '';
const nim = typeof nimValue === 'string' ? nimValue.trim() : '';
const hasNim = Boolean(nim && (/^\d+$/.test(nim) || nim !== displayName));
const accountInitial = displayName.slice(0, 1).toUpperCase();
const logoFallback = 'siDeutsch';
const avatarUrl = await createAvatarSignedUrl(Astro.locals.supabase, profile?.avatar_url);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
      <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <div id="navigation-progress" class="navigation-progress" transition:persist="navigation-progress" aria-hidden="true"></div>
    <div class={`private-shell ${isAdmin ? 'admin-shell' : 'student-shell'}`}>
      <aside class="private-sidebar" id="dashboard-sidebar" aria-label={isAdmin ? 'Navigasi admin' : 'Navigasi mahasiswa'}>
        <div class="sidebar-top-row">
          <a class="sidebar-logo" href={isAdmin ? '/admin' : '/dashboard'} aria-label="siDeutsch">
            <img src="/logo.png" alt="siDeutsch" />
            <span>{logoFallback}</span>
          </a>
          <button class="sidebar-close" type="button" aria-label="Tutup navigasi" aria-controls="dashboard-sidebar">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </button>
        </div>

        <nav class="private-nav">
          {isAdmin ? (
            <a class={`nav-item ${active === 'users' ? 'active' : ''}`} href="/admin" aria-current={active === 'users' ? 'page' : undefined}>
              <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h9M8 13h9M8 17h5" /></svg>
              <span>Manajemen User</span>
            </a>
          ) : (
            <>
              <a class={`nav-item ${active === 'home' ? 'active' : ''}`} href="/dashboard" aria-current={active === 'home' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V10Z" /></svg>
                <span>Beranda</span>
              </a>
              <a class={`nav-item ${active === 'catalog' ? 'active' : ''}`} href="/dashboard/katalog" aria-current={active === 'catalog' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5v-12Z" /><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8M8 10h8" /></svg>
                <span>Katalog Materi</span>
              </a>
              <a class={`nav-item ${active === 'alltagsdeutsch' ? 'active' : ''}`} href="/dashboard/alltags" aria-current={active === 'alltagsdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H6l-3 2 1.2-4.1A7.5 7.5 0 1 1 20 11.5Z" /><path d="M8 11h.01M12 11h.01M16 11h.01" /></svg>
                <span>Alltagsdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'fachdeutsch' ? 'active' : ''}`} href="/dashboard/fach" aria-current={active === 'fachdeutsch' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Z" /><path d="M7 10.2V16c2.8 2.4 7.2 2.4 10 0v-5.8M21 8v7" /></svg>
                <span>Fachdeutsch</span>
              </a>
              <a class={`nav-item ${active === 'bookmark' ? 'active' : ''}`} href="/dashboard/bookmark" aria-current={active === 'bookmark' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21l-6-4-6 4V4.5Z" /></svg>
                <span>Bookmark</span>
              </a>
              <a class={`nav-item ${active === 'help' ? 'active' : ''}`} href="/bantuan" aria-current={active === 'help' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.6 9a2.5 2.5 0 1 1 4.4 1.6c-1.1 1.1-2 1.4-2 3M12 17.5h.01" /></svg>
                <span>Bantuan</span>
              </a>
              <a class="nav-item" href="/pengucapan">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 19h16M7 5v14M17 5v14" /><path d="m10 10 2 4 2-4" /></svg>
                <span>Panduan Pengucapan</span>
              </a>
              <a class="nav-item" href="/grammar">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z" /><path d="M9 8h6M9 12h6M9 16h4" /></svg>
                <span>Tata Bahasa</span>
              </a>
              <a class={`nav-item ${active === 'career' ? 'active' : ''}`} href="/career" aria-current={active === 'career' ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2" /></svg>
                <span>Career</span>
                <span class="coming-soon-badge">Coming Soon</span>
              </a>
            </>
          )}
        </nav>

      </aside>

      <button class="sidebar-overlay" type="button" aria-label="Tutup navigasi"></button>

      <div class="private-main-column">
        <header class="dashboard-header">
          <button
            class="sidebar-toggle"
            type="button"
            aria-label="Buka navigasi"
            aria-expanded="false"
            aria-controls="dashboard-sidebar"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href={isAdmin ? '/admin' : '/dashboard'} aria-label="siDeutsch">
            <img src="/logo.png" alt="siDeutsch" />
          </a>
          {user && (
            <details class="account-dropdown">
              <summary class="account-trigger">
                {avatarUrl ? (
                  <img class="account-avatar" data-avatar-image data-avatar-initial={accountInitial} src={avatarUrl} alt="" />
                ) : (
                  <span class="account-avatar avatar-initial" aria-hidden="true">{accountInitial}</span>
                )}
                <span class="account-copy">
                  <strong>{displayName}</strong>
                  <span>{hasNim ? `NIM ${nim}` : 'Umum'}</span>
                </span>
                <svg class="account-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="account-menu">
                {!isAdmin && <a href="/dashboard/profil">Profil Saya</a>}
                <form action="/logout" method="post">
                  <button type="submit">Logout</button>
                </form>
              </div>
            </details>
          )}
        </header>
        <main class="private-content"><slot /></main>
        <footer class="private-footer">
          <span>© 2026 siDeutsch. Dibuat untuk siapa saja yang ingin belajar bahasa Jerman.</span>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://wa.me/6281288951254" target="_blank" rel="noopener noreferrer">Kontak Admin (WhatsApp)</a>
          <span class="footer-separator" aria-hidden="true">·</span>
          <a href="https://ndhistira.my.id" target="_blank" rel="noopener noreferrer">Created by Nanda Yudhistira · Lihat Portofolio</a>
        </footer>
      </div>
    </div>
  </body>
</html>

<script>
  const setSidebarOpen = (isOpen: boolean, restoreFocus = false) => {
    const shell = document.querySelector<HTMLElement>('.private-shell');
    const sidebarToggle = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
    shell?.classList.toggle('sidebar-open', isOpen);
    sidebarToggle?.setAttribute('aria-expanded', String(isOpen));
    sidebarToggle?.setAttribute('aria-label', isOpen ? 'Tutup navigasi' : 'Buka navigasi');
    if (!isOpen && restoreFocus) sidebarToggle?.focus();
  };

  let sidebarEventsInitialized = false;
  const initializeSidebar = () => {
    if (sidebarEventsInitialized) return;
    sidebarEventsInitialized = true;

    document.querySelectorAll<HTMLImageElement>('.account-dropdown [data-avatar-image]').forEach((image) => {
      const showFallback = () => {
        const fallback = document.createElement('span');
        fallback.className = 'account-avatar avatar-initial';
        fallback.setAttribute('aria-hidden', 'true');
        fallback.textContent = image.dataset.avatarInitial ?? '';
        image.replaceWith(fallback);
      };

      image.addEventListener('error', showFallback, { once: true });
      if (image.complete && image.naturalWidth === 0) showFallback();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('.sidebar-toggle')) setSidebarOpen(true);
      else if (event.target.closest('.sidebar-close, .sidebar-overlay')) setSidebarOpen(false, true);
      else if (event.target.closest('.private-sidebar a')) setSidebarOpen(false);
      if (!event.target.closest('.account-dropdown')) {
        document.querySelectorAll<HTMLDetailsElement>('.account-dropdown[open]').forEach((dropdown) => {
          dropdown.open = false;
        });
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const openDropdown = document.querySelector<HTMLDetailsElement>('.account-dropdown[open]');
        if (openDropdown) {
          openDropdown.open = false;
          openDropdown.querySelector<HTMLElement>('summary')?.focus();
        } else {
          setSidebarOpen(false, true);
        }
      }
    });

    window.matchMedia('(min-width: 821px)').addEventListener('change', (event) => {
      if (event.matches) setSidebarOpen(false);
    });
  };

  document.addEventListener('astro:page-load', initializeSidebar);
  initializeSidebar();

  document.addEventListener('astro:page-load', () => {
    const logo = document.querySelector<HTMLImageElement>('.sidebar-logo img');
    logo?.addEventListener('error', () => {
      const fallback = document.querySelector<HTMLElement>('.sidebar-logo span');
      if (fallback) fallback.hidden = false;
      logo.hidden = true;
    }, { once: true });
  });

  const progressWindow = window as Window & { __sideDeutschProgressInitialized?: boolean };
  if (!progressWindow.__sideDeutschProgressInitialized) {
    progressWindow.__sideDeutschProgressInitialized = true;
    let progressResetTimer: number | undefined;

    document.addEventListener('astro:before-preparation', () => {
      window.clearTimeout(progressResetTimer);
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      progress?.classList.remove('is-complete');
      progress?.classList.add('is-loading');
    });

    document.addEventListener('astro:page-load', () => {
      const progress = document.querySelector<HTMLElement>('#navigation-progress');
      if (!progress?.classList.contains('is-loading')) return;

      progress.classList.add('is-complete');
      progressResetTimer = window.setTimeout(() => {
        progress.classList.remove('is-loading', 'is-complete');
      }, 240);
    });
  }
</script>

<style is:global>
  :root {
    --bg-main: #F9F9FB;
    --bg-dark: #1A1A1E;
    --accent-gold: #E5A93B;
    --accent-red: #D93838;
    --text-main: #2B2D42;
    --card-bg: #ffffff;
    --muted: #6B7280;
    --border: rgba(43, 45, 66, 0.13);
    --shadow: 0 18px 40px rgba(26, 26, 30, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg-main);
    color: var(--text-main);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.6;
  }

  .navigation-progress {
    position: fixed;
    z-index: 10000;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: var(--accent-gold);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, width 0.18s ease;
  }

  .navigation-progress.is-loading {
    opacity: 1;
    width: 78%;
    transition: opacity 0.08s linear, width 0.9s ease-out;
  }

  .navigation-progress.is-complete {
    opacity: 1;
    width: 100%;
    transition: opacity 0.12s ease, width 0.12s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation-progress {
      transition-duration: 0.01ms;
    }
  }

  a,
  button {
    color: inherit;
    font: inherit;
    transition: color 0.18s ease, background-color 0.18s ease, border-color 0.18s ease,
      transform 0.18s ease, box-shadow 0.18s ease;
  }

  .private-shell {
    display: grid;
    min-height: 100vh;
    grid-template-columns: 252px minmax(0, 1fr);
  }

  .private-sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    min-height: 600px;
    flex-direction: column;
    padding: 1.35rem 1rem 1rem;
    background: var(--bg-dark);
    color: #fff;
  }

  .sidebar-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sidebar-logo {
    position: relative;
    display: flex;
    min-height: 52px;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.55rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    text-decoration: none;
  }

  .sidebar-close,
  .sidebar-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .sidebar-close:hover,
  .sidebar-toggle:hover {
    border-color: var(--accent-gold);
    background: rgba(229, 169, 59, 0.12);
    color: var(--accent-gold);
    transform: translateY(-1px) scale(1.02);
  }

  .sidebar-close svg,
  .sidebar-toggle svg {
    width: 22px;
    height: 22px;
  }

  .sidebar-close path,
  .sidebar-toggle path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .sidebar-overlay {
    display: none;
  }

  .sidebar-logo img {
    display: block;
    width: auto;
    height: 40px;
    max-height: 40px;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.1));
  }

  .sidebar-logo img[hidden] {
    display: none;
  }

  .sidebar-logo > span {
    position: relative;
    left: auto;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .private-nav {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    overflow-y: auto;
  }

  .nav-item {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 0.72rem;
    padding: 0.65rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.86rem;
    font-weight: 700;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-icon {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    color: rgba(255, 255, 255, 0.57);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transform: translateX(3px);
  }

  .nav-item:focus-visible,
  .sidebar-close:focus-visible,
  .sidebar-toggle:focus-visible {
    outline: 3px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .private-content button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 7px 16px rgba(26, 26, 30, 0.14);
  }

  .nav-item.active {
    background: rgba(229, 169, 59, 0.16);
    color: var(--accent-gold);
  }

  .nav-item.active .nav-icon {
    color: var(--accent-gold);
  }

  .coming-soon-badge {
    margin-left: auto;
    padding: 0.12rem 0.38rem;
    border: 1px solid rgba(229, 169, 59, 0.35);
    border-radius: 999px;
    color: var(--accent-gold);
    font-size: 0.58rem;
    font-weight: 800;
    line-height: 1.5;
    white-space: nowrap;
  }

  .dashboard-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem clamp(1.25rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
  }

  .dashboard-header > a {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .dashboard-header > a img {
    display: block;
    width: auto;
    height: 36px;
    object-fit: contain;
  }

  .account-dropdown {
    position: relative;
    margin-left: auto;
  }

  .account-trigger {
    display: flex;
    min-width: 170px;
    align-items: center;
    gap: 0.65rem;
    padding: 0.42rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    cursor: pointer;
    list-style: none;
  }

  .account-trigger::-webkit-details-marker {
    display: none;
  }

  .account-trigger:hover,
  .account-dropdown[open] .account-trigger {
    border-color: var(--border);
    background: var(--bg-main);
  }

  .account-trigger:focus-visible {
    outline: 3px solid rgba(229, 169, 59, 0.45);
    outline-offset: 2px;
  }

  .account-avatar {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    place-items: center;
    border: 2px solid rgba(229, 169, 59, 0.55);
    border-radius: 50%;
    object-fit: cover;
    background: #F7E5C2;
    color: var(--text-main);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .account-copy {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 0.05rem;
    text-align: left;
  }

  .account-copy strong,
  .account-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-copy strong {
    color: var(--text-main);
    font-size: 0.79rem;
    line-height: 1.35;
  }

  .account-copy span {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .account-chevron {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    stroke: var(--muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.18s ease;
  }

  .account-dropdown[open] .account-chevron {
    transform: rotate(180deg);
  }

  .account-menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.45rem);
    right: 0;
    display: grid;
    width: 210px;
    gap: 0.25rem;
    padding: 0.45rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .account-menu a,
  .account-menu button {
    display: block;
    width: 100%;
    padding: 0.65rem 0.7rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 700;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .account-menu a:hover {
    background: var(--bg-main);
  }

  .account-menu form {
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .account-menu button {
    color: var(--accent-red);
  }

  .account-menu button:hover {
    background: rgba(217, 56, 56, 0.08);
  }

  .private-main-column {
    display: flex;
    min-width: 0;
    min-height: 100vh;
    flex-direction: column;
  }

  .private-content {
    width: 100%;
    max-width: 1440px;
    flex: 1;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .private-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 1rem clamp(1.25rem, 3vw, 2.5rem);
    background: var(--bg-dark);
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.75rem;
  }

  .private-footer a {
    color: var(--accent-gold);
    font-weight: 700;
    text-decoration: none;
  }

  .private-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .private-footer .footer-separator {
    color: rgba(255, 255, 255, 0.42);
  }

  @media (max-width: 820px) {
    .private-shell {
      display: block;
    }

    .private-sidebar {
      position: fixed;
      z-index: 51;
      top: 0;
      bottom: 0;
      left: 0;
      width: min(300px, calc(100vw - 3rem));
      height: 100vh;
